# ---------------------------------------------------------------
# FRONTEND (Vite) — these are PUBLIC values, safe to ship in the
# browser bundle. Row Level Security protects the data.
# Copy this file to `.env` and fill in your project values.
# ---------------------------------------------------------------
VITE_SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# ---------------------------------------------------------------
# BACKEND (Express API on Railway) — set these as Railway env vars.
# They are used by the Node.js API server (api/server.js).
# ---------------------------------------------------------------

# Supabase (required)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Payment gateways
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# PAYPAL_ENV=sandbox  # set to "sandbox" for testing, "live" for production

# Email (Resend)
RESEND_API_KEY=

# AI providers
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
LOVABLE_API_KEY=
NVIDIA_API_KEY=
EXA_API_KEY=
TAVILY_API_KEY=
SERPAPI_API_KEY=
FIRECRAWL_API_KEY=
AI_PROVIDER_ENC_KEY=
AI_KEY_ENC_SECRET=

# SEO automation
SEO_AGENT_CRON_SECRET=
SEO_CRON_TOKEN=
SEO_ADMIN_EMAIL=
# SEO_ALERT_EMAILS=on  # set to "on" to enable instant alert emails

# MySQL sync (optional)
MYSQL_HOST=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
