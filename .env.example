# ---------------------------------------------------------------
# FRONTEND (Vite) — these are PUBLIC values, safe to ship in the
# browser bundle. Row Level Security protects the data.
# Copy this file to `.env` and fill in your project values.
# ---------------------------------------------------------------
VITE_SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key

# ---------------------------------------------------------------
# BACKEND SECRETS — DO NOT put these in this file or in `.env`.
# They are stored in the Cloud backend's secret manager and are
# only readable from edge functions via Deno.env.get(...).
# Listed here for reference only:
#
#   RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET
#   PAYPAL_CLIENT_ID / PAYPAL_CLIENT_SECRET
#   RESEND_API_KEY
#   LOVABLE_API_KEY
#   OPENAI_API_KEY / GEMINI_API_KEY / ANTHROPIC_API_KEY / DEEPSEEK_API_KEY
#   OPENROUTER_API_KEY / EXA_API_KEY / TAVILY_API_KEY / SERPAPI_API_KEY
#   AI_PROVIDER_ENC_KEY / SEO_AGENT_CRON_SECRET
#   SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY (auto-injected)
# ---------------------------------------------------------------
